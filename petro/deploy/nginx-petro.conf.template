# nginx site config for Petro on the Hostinger KVM1 VPS.
#
# Three subdomains, mirroring the three separate Railway/Render services
# Petro used to deploy (server / app / admin) -- kept as three origins on
# purpose rather than collapsed onto one, because server.js's own
# CORS_ALLOWED_ORIGINS + the meta-tag CSP in user-src/index.html and
# admin-src/index.html already assume the API is a different origin from
# the pages that call it. Collapsing them onto one origin would work too,
# but it changes a security-relevant assumption baked into inherited code
# (see petro/CLAUDE.md, "money-safety invariants" / CORS) -- not something
# to do silently while wiring up a host.
#
# Replace every PETRO_DOMAIN with the real domain before use, e.g.:
#   sed 's/PETRO_DOMAIN/petro-platform.com/g' nginx-petro.conf.template \
#     > /etc/nginx/sites-available/petro
#
# api.PETRO_DOMAIN   -> proxied to the Node backend (server.js via pm2, :3000)
# app.PETRO_DOMAIN   -> static files, petro/user/  (member app)
# qumx.PETRO_DOMAIN  -> static files, petro/admin/ (admin panel)
#
# The admin subdomain is deliberately a random 4-letter string, not the
# word "admin" -- owner: "let the admin not be a subdomain admin, let's
# get a random 4 character letters and words," after the domain went
# public and automated scanners started probing predictable subdomain
# names (admin., portal., backend., etc. are exactly what a subdomain
# wordlist tries first). This is the same X-Robots-Tag/robots.txt
# reasoning below, one level up: it does not stop a targeted attacker who
# already has this exact string, only casual/wordlist discovery. If this
# name is ever regenerated, update it here, in server.js's
# CORS_ALLOWED_ORIGINS, and re-run certbot with the new name -- the three
# must agree, same as every other place this project keeps one fact in
# more than one file.
#
# The two `root` paths below are /srv/petro-src/petro/user and
# /srv/petro-src/petro/admin -- a real fix, not a guess: this template was
# originally written assuming deploy.sh's rsync layout (PETRO_VPS_PATH,
# default /srv/petro), but deploy.sh was never actually usable (a Claude
# session cannot SSH out, see petro/CLAUDE.md's "Hosting" section) -- the
# pipeline actually in use is the VPS pulling this repo itself via git, as a
# sparse checkout of petro/* at /srv/petro-src/petro. If that checkout path
# ever changes on the VPS, these two `root` lines must be updated to match.
#
# TLS: run `certbot --nginx -d api.PETRO_DOMAIN -d app.PETRO_DOMAIN -d qumx.PETRO_DOMAIN`
# after this file is in place and nginx has reloaded on port 80 -- certbot
# rewrites the `listen 443`/`ssl_certificate` lines in place. The bare :80
# server block below exists so certbot's HTTP-01 challenge (and any plain
# request before certs exist) has somewhere to land; certbot itself adds
# the 80->443 redirect once certificates are issued.

# ── shared security headers ────────────────────────────────────────────
# Ported line-for-line from static-server.js / the old render.yaml (the
# Render-era static-host headers), NOT reinvented -- these defend the exact
# same threat model (script injected into a page reading a member's balance
# or session and POSTing it to an attacker's server; the panel being framed
# by another site) regardless of which host serves the bytes. connect-src
# below must keep matching wherever the API actually lives -- if the API
# subdomain ever changes, update it here AND run set-backend-url.js, they
# are independent copies of the same fact.
map $host $csp_header {
    default "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https://api.PETRO_DOMAIN https://*.googleapis.com; worker-src 'self'; manifest-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'";
}

# ── link-preview bots, served an empty page ─────────────────────────────
# Owner: "it is bringing app preview icon plus some words please l need the
# link to be only as it is no add ons" -- a real screenshot of a WhatsApp
# compose box showed a full card (icon, "Petro" title, a description
# sentence) on a pasted /share.html referral link, after two earlier rounds
# (see CLAUDE.md's Follow-up 24/35) had already removed every og:/twitter:
# tag from user-src/index.html. Root cause: WhatsApp's own link-unfurl
# crawler does not depend on og:/twitter: tags at all -- absent those, it
# falls back to whatever else it can find in <head>: the plain <title>, the
# <meta name="description"> (left in place on purpose in both earlier
# rounds, since it also serves search-result snippets, a genuinely
# different job), and <link rel="icon">/apple-touch-icon as the thumbnail.
# Those three tags are real and still needed for their OWN jobs (the
# browser tab, search snippets, the home-screen icon) -- deleting them
# outright would break things nobody asked to break, just to stop a
# crawler from reading them.
#
# So instead of touching the tags again, THIS regenerates the response
# itself for known preview-crawler user agents only: they get
# no-preview.html (no title, no meta, no icon -- nothing to build a card
# from), while every real browser gets the real page, unchanged. Matched
# on the same well-known crawler UA substrings every other site doing this
# uses (WhatsApp's own, Meta/Facebook's, Telegram's, X's, Slack's,
# LinkedIn's, Discord's, Skype's, Reddit's, Pinterest's, VK's) --
# case-insensitive, since a UA string's casing isn't guaranteed.
map $http_user_agent $petro_bot_html {
    default '';
    ~*(WhatsApp|facebookexternalhit|Facebot|TelegramBot|Twitterbot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|redditbot|Pinterest|vkShare|Viber|line-poker) '/no-preview.html';
}

# Hides "nginx/1.24.0 (Ubuntu)" from every response (already visible in a
# plain `curl -I` -- an automated scanner uses exactly that string to pick
# which known nginx CVEs to try first). Cheap, and this file is the one
# place with total 'http' context this project's sites-enabled/* pipeline
# ever gives it (server_tokens is off-only-in-error-pages-too by default in
# recent nginx, but stated explicitly here rather than assumed).
server_tokens off;

# ── rate limiting, ahead of Node -- defense in depth, not a replacement ──
# server.js already rate-limits and locks out admin login attempts on its
# own (see its own "RATE LIMITERS" section and loginLocked()/
# recordLoginFail() -- 8/min via express-rate-limit, a separate 15-minute
# lockout after repeated failures, constant-time key comparison). These
# nginx-level zones exist so a flood is rejected before it even reaches the
# Node process (cheaper, and protects the box itself, not just the app),
# not because the app-level protection was found lacking.
limit_req_zone $binary_remote_addr zone=petro_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=petro_admin_login:10m rate=1r/s;

server {
    listen 80;
    listen [::]:80;
    server_name api.PETRO_DOMAIN app.PETRO_DOMAIN qumx.PETRO_DOMAIN;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 404;
    }
}

# ── api.PETRO_DOMAIN -> server.js (pm2, port 3000) ─────────────────────
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.PETRO_DOMAIN;

    # ssl_certificate / ssl_certificate_key are filled in by certbot.

    client_max_body_size 8m;

    # An API has no page for a search engine to index -- and every hit here
    # is a real backend request, unlike a static host's robots.txt.
    add_header X-Robots-Tag "noindex, nofollow" always;
    location = /robots.txt {
        add_header Content-Type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # /admin/login and /admin/check-key specifically, ahead of the general
    # zone below -- this is where a credential-stuffing/brute-force bot
    # actually aims. A regex location takes precedence over the plain
    # `location /` prefix below regardless of file order, so this is
    # genuinely hit first for these two paths only.
    location ~ ^/admin/(login|check-key)$ {
        limit_req zone=petro_admin_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        limit_req zone=petro_api burst=40 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # server.js does its own rate limiting off X-Forwarded-For (it trusts
        # app.set('trust proxy', ...) upstream) -- nginx must not strip or
        # rewrite this header, only append to it (the default proxy_pass
        # behaviour above already does that correctly).
    }

    location = /health {
        proxy_pass http://127.0.0.1:3000/health;
        access_log off;
    }
}

# ── app.PETRO_DOMAIN -> petro/user/ (member app, one inline bundle) ────
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name app.PETRO_DOMAIN;

    root /srv/petro-src/petro/user;
    index index.html;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy $csp_header always;
    add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header Cross-Origin-Resource-Policy "same-site" always;

    # Old-style referral links (<origin>/refCode=<code>) are a real URL
    # path, not a query string -- without this rewrite every invite sent
    # before Round 158 (new links use /?ref=<code>, which needs no rule)
    # 404s. Scoped to this exact prefix on purpose: a blanket try_files
    # fallback to index.html would also swallow sw.js and the manifest.
    location ^~ /refCode= {
        rewrite ^ /index.html break;
    }

    # index.html / sw.js / manifest.json revalidate on every load (a new
    # build must be picked up immediately -- phones sitting on a stale
    # cached shell is this project's single most recurring complaint).
    # Every other asset (product images, icons) is fine to cache normally;
    # nothing here is versioned in its filename, so this stays conservative
    # rather than copying an aggressive immutable-cache policy from a
    # typical static-site config.
    # $petro_bot_html (see the map above) is '' for every real browser, so
    # try_files' first argument is empty and it falls straight through to
    # the real file exactly as before -- a known preview-crawler UA is the
    # only case that ever actually serves no-preview.html here.
    location = / {
        try_files $petro_bot_html /index.html =404;
        add_header Cache-Control "no-cache";
    }
    location = /index.html { try_files $petro_bot_html /index.html =404; add_header Cache-Control "no-cache"; }
    # share.html is a literal duplicate of index.html's own bytes (referral
    # links now point here -- see build-core.js/captureReferralFromUrl()'s
    # own comments) -- same no-cache treatment, same reason, and the same
    # bot short-circuit since a shared referral link is exactly the URL
    # shape that gets pasted into WhatsApp.
    location = /share.html { try_files $petro_bot_html /share.html =404; add_header Cache-Control "no-cache"; }
    location = /sw.js       { add_header Cache-Control "no-cache"; }
    location = /manifest.json { add_header Cache-Control "no-cache"; }

    # `try_files $uri =404` alone (a first-draft, never live-tested version
    # of this template) treats a bare `/` request as a literal file lookup,
    # which fails since root+"/" is a directory, not a file -- it falls
    # straight to =404 without ever consulting `index` above. The `$uri/`
    # alternative is what makes nginx recognize the directory match and
    # apply `index index.html` -- found live on the real domain cutover
    # (index.html itself served fine via its exact filename, only `/`
    # 404'd), not caught by a syntax check, since this is valid nginx that
    # just does the wrong thing. The exact-match `location = /` above
    # already covers the bare-root case now, so this is everything else.
    location / {
        try_files $uri $uri/ =404;
    }
}

# ── qumx.PETRO_DOMAIN -> petro/admin/ (admin panel, moves money) ──────
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name qumx.PETRO_DOMAIN;

    root /srv/petro-src/petro/admin;
    index index.html;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy $csp_header always;
    add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header Cross-Origin-Resource-Policy "same-site" always;
    # A search engine indexing "petro admin login" is a worse outcome than
    # a slightly less discoverable panel -- this doesn't stop a targeted
    # attacker (the subdomain is still a normal, reachable HTTPS site,
    # same as it always was; this only keeps it out of casual search
    # results and crawlers), real access control is still the login form
    # itself and server.js's own admin auth.
    add_header X-Robots-Tag "noindex, nofollow" always;

    # The whole panel is one file -- every request revalidates, same
    # reasoning as index.html above but for all of it, not just three names.
    add_header Cache-Control "no-cache";

    location = /robots.txt {
        add_header Content-Type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
