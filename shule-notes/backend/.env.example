# Copy to .env on the VPS (never commit the real .env).

# MongoDB Atlas connection string. The database name is read from the URI
# itself -- make sure it ends with /shule_notes (or your chosen name), or
# writes silently land in Atlas's default "test" database.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/shule_notes?retryWrites=true&w=majority

# The Claude API key. Never put this in the Android app -- it lives on this
# server only.
ANTHROPIC_API_KEY=sk-ant-...

# Which model answers "Ask AI" questions. Anthropic's own current default is
# the most expensive tier (Opus 5.5) -- for a free student Q&A feature, start
# cheaper and raise it only if answer quality genuinely needs it.
#   claude-haiku-5-5   cheapest,  $0.10 / $0.50 per million tokens
#   claude-sonnet-5-5  balanced,  $2.00 / $10.00 per million tokens (default)
#   claude-opus-5-5    best,      $4.00 / $20.00 per million tokens
AI_MODEL=claude-sonnet-5-5

# How many "Ask AI" questions one student may ask per day. This is what
# actually caps your Claude API bill -- raise it only once you know your
# real per-question cost.
AI_DAILY_LIMIT=20

# The single shared admin-panel password. Generate a long random string --
# this is not a user password, it is the key to uploading/deleting content.
ADMIN_KEY=

# Comma-separated list of origins allowed to call this API (your admin
# panel's URL; the Android app itself does not send an Origin header, so it
# is unaffected by this list).
ALLOWED_ORIGINS=https://admin.yourdomain.com

PORT=4000

# Where uploaded PDFs are stored on the VPS's own disk. Must be on a volume
# with real persistent storage and enough room for your note library.
UPLOAD_DIR=/var/lib/shule-notes/uploads
